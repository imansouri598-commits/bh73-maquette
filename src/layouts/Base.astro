---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Entete from '../components/layout/Entete.astro';
import PiedDePage from '../components/layout/PiedDePage.astro';
import BarreActions from '../components/layout/BarreActions.astro';
import { lien } from '../data/lien';

type Props = { titre: string; description: string };
const { titre, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <!-- Maquette : ne pas indexer tant que le site n'est pas validé. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#202020" />
    <link rel="icon" type="image/png" href={lien('/favicon.png')} />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>

    <div class="bandeau-maquette">
      <div class="conteneur">Maquette · proposition de nouveau site pour BH 73</div>
    </div>

    <Entete />

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <PiedDePage />
    <BarreActions />
  </body>
</html>

<style is:global>
  /* Lien d'évitement : invisible tant qu'on ne l'atteint pas au clavier (première tabulation). */
  .evitement {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 50;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--or);
    color: var(--encre);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .evitement:focus {
    transform: none;
  }

  #contenu:focus {
    outline: none;
  }

  .bandeau-maquette {
    background: #fff3cd;
    color: #6b4e00;
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
    padding-block: 6px;
  }
</style>
