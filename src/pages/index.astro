---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Atouts from '../components/sections/Atouts.astro';
import Univers from '../components/sections/Univers.astro';
import EnLigne from '../components/sections/EnLigne.astro';
import Instagram from '../components/sections/Instagram.astro';
import Avis from '../components/sections/Avis.astro';
import Infos from '../components/sections/Infos.astro';

// Ordre du parcours : les questions du visiteur, dans l'ordre où il se les pose.
// Qui et où ? (Hero) · Pourquoi y aller ? (Atouts) · Qu'y trouve-t-on ? (Univers) · Et à distance ? (EnLigne)
// · Quoi de neuf ? (Instagram) · Est-ce bien ? (Avis) · Quand et comment venir ? (Infos, juste avant le pied de page).
// Les rubriques du menu suivent le même ordre. Fonds : photo, charbon, crème, encre, sable, crème, lin, puis
// pied de page charbon : deux sections voisines n'ont jamais le même fond.
---

<Base
  titre="BH 73 Concept store · Déco, mobilier, mode et seconde main à Angoulême"
  description="Concept store au 381 rue de Bordeaux à Angoulême : décoration, mobilier, vaisselle, vêtements, bijoux et seconde main. Parking devant la porte, livraison sur 20 km."
>
  <Hero />
  <Atouts />
  <Univers />
  <EnLigne />
  <Instagram />
  <Avis />
  <Infos />
</Base>
