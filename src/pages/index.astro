---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Statut from '../components/Statut.astro';
import lucane from '../assets/lucane.png';
import { magasin, photos, univers, avis, horaires, horairesAConfirmer } from '../data/magasin';
import { produitsEnLigne } from '../data/boutique';
import { lien } from '../data/lien';

const produits = await produitsEnLigne(4);

// Photo d'accueil : cadrage vertical sur mobile, paysage au-delà.
const heroMobile = await getImage({ src: photos.heroMobile, widths: [480, 768, 1080, 1536], format: 'webp' });
const heroOrdinateur = await getImage({ src: photos.heroOrdinateur, widths: [960, 1440, 1920, 2752], format: 'webp' });

const atouts = [
  { icone: 'parking', titre: 'Parking devant la porte', texte: 'On se gare sans chercher, face au Lidl.' },
  { icone: 'livraison', titre: 'Livraison sur 20 km', texte: 'Le meuble repart chez vous, pas dans votre coffre.' },
  { icone: 'vintage', titre: 'Seconde main & vintage', texte: 'Des pièces chinées, à côté du neuf.' },
  { icone: 'etoile', titre: 'Recommandée sur Google', texte: 'L’accueil, le choix et les prix reviennent dans les avis.' },
] as const;

const fil = [
  photos.lampeCollage,
  photos.sacCuirRouge,
  photos.tableVannerie,
  photos.ceramiqueVerte,
  photos.echarpeCarree,
  photos.commodeVases,
];

const formatCreneaux = (creneaux: [string, string][]) =>
  creneaux.length ? creneaux.map(([o, f]) => `${o.replace(':', ' h ')} – ${f.replace(':', ' h ')}`.replaceAll(' h 00', ' h')).join(' · ') : 'Fermé';

// Lundi en premier pour l'affichage.
const semaine = [...horaires.slice(1), horaires[0]].map((j) => ({ ...j, index: horaires.indexOf(j) }));
---

<Base
  titre="BH 73 Concept store · Déco, mobilier, mode et seconde main à Angoulême"
  description="Concept store au 381 rue de Bordeaux à Angoulême : décoration, mobilier, vaisselle, vêtements, bijoux et seconde main. Parking devant la porte, livraison sur 20 km."
>
  <!-- Accueil -->
  <section class="hero">
    <picture>
      <source media="(max-width: 699px)" srcset={heroMobile.srcSet.attribute} sizes="100vw" />
      <source srcset={heroOrdinateur.srcSet.attribute} sizes="100vw" />
      <img
        src={heroOrdinateur.src}
        alt="L'intérieur de la boutique BH 73 le soir : suspensions en fibres naturelles allumées, coussins, plantes et mobilier"
        class="hero__photo"
        width={photos.heroOrdinateur.width}
        height={photos.heroOrdinateur.height}
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero__voile"></div>
    <div class="conteneur hero__contenu">
      <p class="hero__surtitre">Concept store · 381 rue de Bordeaux, Angoulême</p>
      <h1 class="hero__titre">Déco, mobilier, mode et trouvailles de seconde main.</h1>
      <p class="hero__texte">
        Une sélection qui change au fil des arrivages, dans une boutique où l'on prend le temps de vous conseiller.
      </p>
      <Statut class="hero__statut" />
      <div class="hero__actions">
        <a class="bouton bouton--or" href={magasin.telephone.lien}><Icone nom="telephone" />Appeler la boutique</a>
        <a class="bouton bouton--clair" href={magasin.itineraire}><Icone nom="itineraire" />Itinéraire</a>
      </div>
    </div>
  </section>

  <!-- Atouts -->
  <section class="atouts" aria-label="Les atouts de la boutique">
    <div class="conteneur atouts__grille">
      {
        atouts.map((a) => (
          <div class="atout">
            <span class="atout__icone">
              <Icone nom={a.icone} />
            </span>
            <div>
              <p class="atout__titre">{a.titre}</p>
              <p class="atout__texte">{a.texte}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Univers -->
  <section class="section" id="univers">
    <div class="conteneur">
      <p class="surtitre">En boutique</p>
      <h2 class="titre-section">Six univers sous un même toit</h2>
      <p class="chapo">Du neuf et du chiné, des petits prix et des pièces uniques. Chaque univers a sa page, avec ses photos et ses rayons.</p>

      <div class="univers">
        {
          univers.map((u, i) => (
            <a href={lien(`/univers/${u.slug}/`)} class:list={['carte', { 'carte--large': i === 0 }]}>
              <div class="carte__media">
                {u.photo ? (
                  <Image src={u.photo} alt="" widths={[400, 700, 1000]} sizes="(min-width: 960px) 40vw, 100vw" />
                ) : (
                  <div class="carte__vide">
                    <Image src={lucane} alt="" width={120} />
                    <span>Photos à faire en boutique</span>
                  </div>
                )}
              </div>
              <div class="carte__texte">
                <h3>{u.titre}</h3>
                <p>{u.accroche}</p>
                <span class="carte__lien">
                  Découvrir <Icone nom="fleche" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Boutique en ligne -->
  {
    produits.length > 0 && (
      <section class="section en-ligne" id="en-ligne">
        <div class="conteneur">
          <div class="en-ligne__entete">
            <div>
              <p class="surtitre surtitre--clair">Aussi en ligne</p>
              <h2 class="titre-section">Commandez depuis chez vous</h2>
              <p class="chapo chapo--clair">Une partie de la sélection est disponible sur la boutique en ligne. Ces produits s'affichent ici automatiquement.</p>
            </div>
            <a class="bouton bouton--or" href={magasin.boutiqueEnLigne}>
              <Icone nom="sac" />
              Voir la boutique en ligne
            </a>
          </div>
          <div class="produits">
            {produits.map((p) => (
              <a class="produit" href={p.url}>
                <div class="produit__media">
                  <img src={p.image} alt={p.titre} loading="lazy" width="700" height="875" />
                </div>
                <p class="produit__titre">{p.titre}</p>
                <p class="produit__prix">{p.prix}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Instagram -->
  <section class="section insta">
    <div class="conteneur insta__grille">
      <div class="insta__texte">
        <p class="surtitre">Les arrivages</p>
        <h2 class="titre-section">Les nouveautés passent d'abord sur Instagram</h2>
        <p class="chapo">
          Près de 5 000 personnes suivent les arrivages sur {magasin.instagram.compte}. Une pièce vous plaît ? Appelez la boutique pour savoir si elle est encore là.
        </p>
        <div class="insta__actions">
          <a class="bouton bouton--sombre" href={magasin.instagram.url}><Icone nom="instagram" />Suivre {magasin.instagram.compte}</a>
          <a class="bouton bouton--contour" href={magasin.telephone.lien}><Icone nom="telephone" />Réserver une pièce</a>
        </div>
      </div>
      <a class="insta__mur" href={magasin.instagram.url} aria-label="Voir les publications sur Instagram">
        {fil.map((p) => <Image src={p} alt="" widths={[240, 400]} sizes="(min-width: 960px) 200px, 33vw" />)}
      </a>
    </div>
  </section>

  <!-- Avis -->
  <section class="section avis" id="avis">
    <div class="conteneur">
      <p class="surtitre">Ils sont passés</p>
      <h2 class="titre-section">Ce qu'en disent les clients</h2>
      <div class="avis__grille">
        {
          avis.map((a) => (
            <figure class="avis__carte">
              <div class="avis__etoiles" aria-label="5 étoiles sur 5">
                {[1, 2, 3, 4, 5].map(() => (
                  <Icone nom="etoile" />
                ))}
              </div>
              <blockquote>« {a.texte} »</blockquote>
              <figcaption>{a.auteur} · avis Google</figcaption>
            </figure>
          ))
        }
      </div>
      <a class="bouton bouton--contour avis__lien" href={magasin.avisGoogle}>Lire tous les avis sur Google <Icone nom="fleche" /></a>
    </div>
  </section>

  <!-- Infos pratiques -->
  <section class="section infos" id="infos">
    <div class="conteneur infos__grille">
      <div>
        <p class="surtitre">Venir à la boutique</p>
        <h2 class="titre-section">Infos pratiques</h2>
        <Statut class="infos__statut" />

        <dl class="infos__liste">
          <div>
            <dt><Icone nom="itineraire" />Adresse</dt>
            <dd>{magasin.adresse.rue}, {magasin.adresse.ville}<br /><span class="discret">Parking devant le magasin, face au Lidl</span></dd>
          </div>
          <div>
            <dt><Icone nom="telephone" />Téléphone</dt>
            <dd><a href={magasin.telephone.lien}>{magasin.telephone.affiche}</a></dd>
          </div>
          <div>
            <dt><Icone nom="email" />Email</dt>
            <dd><a href={`mailto:${magasin.email}`}>{magasin.email}</a></dd>
          </div>
        </dl>

        <h3 class="infos__sous-titre">
          <Icone nom="horloge" />Horaires {horairesAConfirmer && <span class="a-confirmer">exemple à confirmer</span>}
        </h3>
        <table class="horaires">
          <tbody>
            {
              semaine.map((j) => (
                <tr data-jour={j.index}>
                  <th scope="row">{j.jour}</th>
                  <td>{formatCreneaux(j.creneaux)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="infos__actions">
          <a class="bouton bouton--sombre" href={magasin.itineraire}><Icone nom="itineraire" />Itinéraire</a>
          <a class="bouton bouton--contour" href={magasin.telephone.lien}><Icone nom="telephone" />Appeler</a>
        </div>
      </div>
      <div class="infos__carte">
        <iframe
          src={magasin.carte}
          title="Plan d'accès à BH 73, 381 rue de Bordeaux à Angoulême"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Accueil */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(86svh, 760px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero__voile {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(20 18 16 / 0.15) 0%, rgb(20 18 16 / 0.35) 40%, rgb(20 18 16 / 0.9) 100%),
      linear-gradient(90deg, rgb(20 18 16 / 0.55) 0%, transparent 70%);
  }

  .hero__contenu {
    padding-block: 120px 56px;
  }

  .hero__surtitre {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--or-clair);
  }

  .hero__titre {
    margin-top: 16px;
    max-width: 14ch;
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 500;
  }

  .hero__texte {
    margin-top: 18px;
    max-width: 46ch;
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.88);
  }

  .hero__statut {
    margin-top: 26px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(20 18 16 / 0.55);
    backdrop-filter: blur(6px);
    font-size: 0.95rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  /* Atouts */
  .atouts {
    background: var(--charbon);
    color: #fff;
    padding-block: 28px;
  }

  .atouts__grille {
    display: grid;
    gap: 22px;
  }

  @media (min-width: 640px) {
    .atouts__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .atouts__grille {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .atout {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .atout__icone {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(189 129 15 / 0.5);
    color: var(--or-clair);
  }

  .atout__icone svg {
    width: 22px;
    height: 22px;
  }

  .atout__titre {
    font-weight: 600;
  }

  .atout__texte {
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.68);
  }

  /* Univers */
  .univers {
    display: grid;
    gap: 18px;
    margin-top: 44px;
  }

  @media (min-width: 640px) {
    .univers {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .univers {
      grid-template-columns: repeat(3, 1fr);
    }
    .carte--large {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .carte {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 340px;
    border-radius: var(--rayon);
    overflow: hidden;
    background: var(--encre);
    color: #fff;
    text-decoration: none;
    box-shadow: var(--ombre);
  }

  .carte__media {
    position: absolute;
    inset: 0;
  }

  .carte__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .carte:hover .carte__media img {
    transform: scale(1.04);
  }

  .carte::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(20 18 16 / 0.85) 100%);
  }

  .carte__texte {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: 22px;
  }

  .carte__texte h3 {
    font-size: 1.6rem;
  }

  .carte--large .carte__texte h3 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .carte__texte p {
    margin-top: 6px;
    color: rgb(255 255 255 / 0.8);
  }

  .carte__lien {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-weight: 600;
    color: var(--or-clair);
  }

  .carte__lien svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }

  .carte:hover .carte__lien svg {
    transform: translateX(4px);
  }

  /* Boutique en ligne */
  .en-ligne {
    background: var(--encre);
    color: #fff;
  }

  .en-ligne__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .produits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 40px;
  }

  @media (min-width: 960px) {
    .produits {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .produit {
    text-decoration: none;
  }

  .produit__media {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: #2a2724;
  }

  .produit__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .produit:hover .produit__media img {
    transform: scale(1.04);
  }

  .produit__titre {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.9);
  }

  .produit__prix {
    margin-top: 4px;
    font-weight: 600;
    color: var(--or-clair);
  }

  /* Instagram */
  .insta {
    background: var(--sable);
  }

  .insta__grille {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .insta__grille {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }

  .insta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .insta__mur {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .insta__mur img {
    aspect-ratio: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    transition: opacity 0.2s;
  }

  .insta__mur:hover img {
    opacity: 0.85;
  }

  /* Avis */
  .avis__grille {
    display: grid;
    gap: 18px;
    margin-top: 40px;
  }

  @media (min-width: 760px) {
    .avis__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .avis__grille {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .avis__carte {
    margin: 0;
    padding: 26px;
    border-radius: var(--rayon);
    background: var(--lin);
    border: 1px solid var(--trait);
    display: flex;
    flex-direction: column;
  }

  .avis__etoiles {
    display: flex;
    gap: 2px;
    color: var(--or);
  }

  .avis__etoiles svg {
    width: 18px;
    height: 18px;
  }

  .avis__carte blockquote {
    margin: 16px 0 0;
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.45;
  }

  .avis__carte figcaption {
    margin-top: auto;
    padding-top: 18px;
    font-size: 0.9rem;
    color: var(--discret);
  }

  .avis__lien {
    margin-top: 32px;
  }

  /* Infos pratiques */
  .infos {
    background: var(--lin);
  }

  .infos__grille {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 960px) {
    .infos__grille {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }

  .infos__statut {
    margin-top: 18px;
  }

  .infos__liste {
    display: grid;
    gap: 16px;
    margin: 28px 0 0;
  }

  .infos__liste dt,
  .infos__sous-titre {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--or-fonce);
  }

  .infos__liste svg,
  .infos__sous-titre svg {
    width: 16px;
    height: 16px;
  }

  .infos__liste dd {
    margin: 4px 0 0;
    font-size: 1.05rem;
  }

  .infos__liste a {
    text-decoration-color: var(--or);
    text-underline-offset: 3px;
  }

  .discret {
    color: var(--discret);
    font-size: 0.95rem;
  }

  .infos__sous-titre {
    margin-top: 32px;
    font-family: var(--sans);
  }

  .horaires {
    width: 100%;
    margin-top: 10px;
    border-collapse: collapse;
  }

  .horaires th,
  .horaires td {
    padding: 9px 0;
    border-bottom: 1px solid var(--trait);
    text-align: left;
    font-weight: 400;
  }

  .horaires td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .horaires tr.aujourdhui th,
  .horaires tr.aujourdhui td {
    font-weight: 700;
    color: var(--or-fonce);
  }

  .infos__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .infos__carte {
    min-height: 380px;
    border-radius: var(--rayon);
    overflow: hidden;
    box-shadow: var(--ombre);
    background: var(--sable);
  }

  .infos__carte iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
  }
</style>
