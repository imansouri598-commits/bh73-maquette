---
import Icone from '../Icone.astro';
import { magasin } from '../../data/magasin';
import { produitsEnLigne } from '../../data/boutique';

const produits = await produitsEnLigne(4);
---

<!-- Boutique en ligne -->
{
  produits.length > 0 && (
    <section class="section en-ligne" id="en-ligne">
      <div class="conteneur">
        <div class="en-ligne__entete">
          <div>
            <p class="surtitre surtitre--clair">Aussi en ligne</p>
            <h2 class="titre-section">Commandez depuis chez vous</h2>
            <p class="chapo chapo--clair">Une partie de la sélection est disponible sur la boutique en ligne. Ces produits s'affichent ici automatiquement.</p>
          </div>
          <a class="bouton bouton--or" href={magasin.boutiqueEnLigne}>
            <Icone nom="sac" />
            Voir la boutique en ligne
          </a>
        </div>
        <div class="produits">
          {produits.map((p) => (
            <a class="produit" href={p.url}>
              <div class="produit__media">
                <img src={p.image} alt={p.titre} loading="lazy" width="700" height="875" />
              </div>
              <p class="produit__titre">{p.titre}</p>
              <p class="produit__prix">{p.prix}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style is:global>
  /* Boutique en ligne */
  .en-ligne {
    background: var(--encre);
    color: #fff;
  }

  .en-ligne__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .produits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 40px;
  }

  @media (min-width: 960px) {
    .produits {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .produit {
    text-decoration: none;
  }

  .produit__media {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: #2a2724;
  }

  .produit__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .produit:hover .produit__media img {
    transform: scale(1.04);
  }

  .produit__titre {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.9);
  }

  .produit__prix {
    margin-top: 4px;
    font-weight: 600;
    color: var(--or-clair);
  }
</style>
