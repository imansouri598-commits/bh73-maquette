---
import Icone from '../Icone.astro';
import { magasin, preuves } from '../../data/magasin';
import { extraits } from '../../data/avis';

// Typographie française sans toucher aux mots : apostrophes courbes, et les espaces déjà présentes
// avant ! ? : ; » ou après « deviennent insécables (la ponctuation ne part plus seule à la ligne).
const typo = (texte: string) =>
  texte
    .replace(/'/g, '’')
    .replace(/ ([!?:;»])/g, '\u00A0$1')
    .replace(/« /g, '«\u00A0');
---

<!-- Avis -->
<section class="section avis" id="avis" aria-labelledby="avis-titre">
  <div class="conteneur avis__mise-en-page">
    <div class="avis__entete">
      <p class="surtitre">Avis Google</p>
      <h2 class="titre-section" id="avis-titre">Accueil, choix, prix&nbsp;: les clients en parlent</h2>
    </div>

    <div class="avis__grille">
      {
        extraits.map((e) => (
          <figure class="avis__carte">
            <div class="avis__haut">
              <span class="pastille">{e.theme}</span>
              <span class="avis__etoiles" role="img" aria-label="Avis noté 5 étoiles sur 5">
                {[1, 2, 3, 4, 5].map(() => (
                  <Icone nom="etoile" />
                ))}
              </span>
            </div>
            <blockquote class="avis__citation">
              <p>«&nbsp;{typo(e.citation)}&nbsp;»</p>
            </blockquote>
            <figcaption class="avis__auteur">{e.auteur} · avis Google</figcaption>
          </figure>
        ))
      }

      <!-- Encadré « Bon à savoir » de la fiche Google Maps : résumé généré par Google à partir des avis (relevé le 16/10/2026). -->
      <div class="avis__google">
        <span class="pastille pastille--or">Résumé Google</span>
        <h3 class="avis__google-titre">Bon à savoir</h3>
        <ul class="avis__google-liste">
          {preuves.googleBonASavoir.map((phrase) => <li>{phrase}.</li>)}
        </ul>
        <p class="avis__google-source">Généré par Google Maps à partir des avis.</p>
      </div>
    </div>

    <a class="bouton bouton--contour avis__lien" href={magasin.avisGoogle}>Lire tous les avis sur Google <Icone nom="fleche" /></a>
  </div>
</section>

<style is:global>
  /* Avis */
  .avis__mise-en-page {
    display: grid;
    gap: 32px;
  }

  .avis__grille {
    display: grid;
    gap: 14px;
  }

  .avis__lien {
    justify-self: start;
  }

  @media (min-width: 640px) {
    .avis__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media (min-width: 1100px) {
    .avis__mise-en-page {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'entete lien'
        'grille grille';
      align-items: end;
      gap: 40px 32px;
    }

    .avis__entete {
      grid-area: entete;
    }

    .avis__lien {
      grid-area: lien;
    }

    /* Le résumé Google, plus long, a une colonne un peu plus large : les quatre blocs gardent la même hauteur. */
    .avis__grille {
      grid-area: grille;
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.3fr);
    }
  }

  .avis__carte {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 22px;
    border-radius: var(--rayon);
    background: var(--lin);
    border: 1px solid var(--trait);
  }

  .avis__haut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .avis__etoiles {
    display: inline-flex;
    gap: 2px;
    color: var(--or);
  }

  .avis__etoiles svg {
    width: 16px;
    height: 16px;
  }

  .avis__citation {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.45;
  }

  @media (min-width: 1100px) {
    .avis__citation {
      font-size: 1.16rem;
    }
  }

  .avis__auteur {
    margin-top: auto;
    font-size: 0.9rem;
    color: var(--discret);
  }

  /* Résumé Google : noir et or, pour le distinguer des avis de clients. */
  .avis__google {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 22px;
    border-radius: var(--rayon);
    background: var(--charbon);
    color: rgb(255 255 255 / 0.88);
  }

  .avis__google-titre {
    font-size: 1.45rem;
    color: #fff;
  }

  .avis__google-liste {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .avis__google-liste li {
    position: relative;
    padding-left: 20px;
  }

  .avis__google-liste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--or-clair);
  }

  .avis__google-source {
    margin-top: auto;
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.62);
  }
</style>
