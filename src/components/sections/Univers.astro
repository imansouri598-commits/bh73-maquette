---
import CarteUnivers from '../univers/CarteUnivers.astro';
import { univers } from '../../data/univers';
---

<!-- Univers -->
<section class="section" id="univers" aria-labelledby="univers-titre">
  <div class="conteneur">
    <p class="surtitre">En boutique</p>
    <h2 class="titre-section" id="univers-titre">Six univers sous un même toit</h2>
    <p class="chapo">Du neuf et du chiné, de la déco aux bijoux. Choisissez un univers pour voir ses rayons et ses photos.</p>

    <ul class="univers__grille" role="list">
      {
        univers.map((u, i) => (
          <li class:list={{ 'univers__item--large': i === 0 }}>
            <CarteUnivers u={u} large={i === 0} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  /* Univers : six lignes compactes sur téléphone, mosaïque de photos au-delà */
  .univers__grille {
    display: grid;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .univers__grille {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-top: 44px;
    }
  }

  @media (min-width: 960px) {
    .univers__grille {
      grid-template-columns: repeat(3, 1fr);
    }

    .univers__item--large {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>
