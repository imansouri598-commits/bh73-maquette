---
// Photo d'univers : texte alternatif et point d'intérêt tirés de data/univers.ts,
// bande parasite d'un fichier retirée à la génération (recadrage par le service d'images d'Astro).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { infosPhoto } from '../../data/univers';

type Props = {
  src: ImageMetadata;
  widths: number[];
  sizes: string;
  /** alt="" quand la photo illustre un lien qui porte déjà le nom de l'univers. */
  decorative?: boolean;
  priority?: boolean;
  class?: string;
};

const { src, widths, sizes, decorative = false, priority = false, class: classe } = Astro.props;
const infos = infosPhoto(src);
const recadrage = infos.rognageDroite
  ? { width: src.width - infos.rognageDroite, height: src.height, fit: 'cover' as const, position: 'left' }
  : {};
---

<Image
  src={src}
  alt={decorative ? '' : infos.alt}
  widths={widths}
  sizes={sizes}
  priority={priority}
  class={classe}
  style={infos.cadrage ? `object-position: ${infos.cadrage}` : undefined}
  {...recadrage}
/>
