---
import { horaires } from '../data/horaires';
import { resumeHoraires } from '../data/horaires-calcul';

// API inchangée : seule la classe est paramétrable (utilisé par le Hero et les Infos, plusieurs fois par page si besoin).
type Props = { class?: string };
const { class: classe } = Astro.props;

// Texte de repli, lisible sans JavaScript et avant le premier calcul : les horaires habituels.
const repli = resumeHoraires(horaires);
---

<span class:list={['statut', classe]} data-statut>
  <span class="statut__point" aria-hidden="true"></span>
  <span class="statut__texte">{repli}</span>
</span>

<script>
  import { horaires, fermeturesExceptionnelles } from '../data/horaires';
  import { etatBoutique } from '../data/horaires-calcul';

  // Un seul script pour toutes les instances du badge (Astro ne l'inclut qu'une fois par page).
  // Calcul à l'heure de Paris, quel que soit le fuseau du visiteur (voir horaires-calcul.ts).
  function calculer() {
    try {
      return etatBoutique(new Date(), horaires, fermeturesExceptionnelles);
    } catch {
      return null; // Intl indisponible : le texte de repli reste affiché.
    }
  }

  function mettreAJour() {
    const statut = calculer();
    if (!statut) return;
    document.querySelectorAll<HTMLElement>('[data-statut]').forEach((badge) => {
      badge.dataset.etat = statut.etat;
      const texte = badge.querySelector('.statut__texte');
      if (texte && texte.textContent !== statut.texte) texte.textContent = statut.texte;
    });
    // Jour en cours mis en avant partout où un élément porte data-jour (0 = dimanche) : tableau des horaires.
    document.querySelectorAll<HTMLElement>('[data-jour]').forEach((el) => {
      const estAujourdhui = Number(el.dataset.jour) === statut.jour;
      el.classList.toggle('aujourdhui', estAujourdhui);
      if (estAujourdhui) el.setAttribute('aria-current', 'date');
      else el.removeAttribute('aria-current');
    });
    // Fermetures exceptionnelles annoncées (data-jusquau = dernier jour) : masquées une fois passées.
    document.querySelectorAll<HTMLElement>('[data-jusquau]').forEach((el) => {
      el.hidden = (el.dataset.jusquau ?? '') < statut.date;
    });
  }

  // Recalcul à chaque changement de minute (les « ferme dans 35 min » restent justes),
  // et dès que l'onglet redevient visible ou que la page revient de l'historique (minuteries suspendues entre-temps).
  function planifier() {
    mettreAJour();
    setTimeout(planifier, 60_000 - (Date.now() % 60_000) + 50);
  }
  planifier();
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) mettreAJour();
  });
  window.addEventListener('pageshow', mettreAJour);
</script>
